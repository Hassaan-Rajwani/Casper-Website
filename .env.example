# Next.js server port (optional)
PORT=3000

# Firebase web app config
# Exact values for API key, App ID, and Messaging Sender ID must come from
# Firebase Console > Project Settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=casper-19ac6
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=casper-19ac6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=casper-19ac6.firebasestorage.app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional admin credentials
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_PASSWORD=
