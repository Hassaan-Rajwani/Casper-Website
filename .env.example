# Next.js server port (optional)
PORT=3000

# Firebase web app config
# Exact values for API key, App ID, and Messaging Sender ID must come from
# Firebase Console > Project Settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Optional admin credentials
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_PASSWORD=

# tawk.to live chat (from Dashboard > Administration > Channels > Chat Widget > Direct Chat Link)
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_property_id
NEXT_PUBLIC_TAWK_WIDGET_ID=your_widget_id

# Public contact + order notification email via FormSubmit
NEXT_PUBLIC_CONTACT_EMAIL=your-email@example.com
NEXT_PUBLIC_ORDER_NOTIFICATION_EMAIL=your-email@example.com

# Production site URL for order tracking links in customer emails
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Server-only Firebase Admin credentials (Netlify env, NOT public)
# Firebase Console > Project Settings > Service accounts > Generate new private key
# Paste the full JSON as one line, or use FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 instead
FIREBASE_SERVICE_ACCOUNT_JSON=
